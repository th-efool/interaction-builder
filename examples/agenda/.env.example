# Server Configuration
PORT=3030

# Storage Engine:
# Set to "memory" for instant in-memory quickstart without database dependencies.
# Or provide a PostgreSQL connection string for durable production storage.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agenda_db

# Embedded Worker:
# Set to "true" to run the assistant background worker within the server process,
# or set to "false" to run a dedicated worker instance via `npm run worker`.
EMBEDDED_WORKER=true
